graph TB
    subgraph External["Внешние системы"]
        InsCompanies["Страховые компании<br/>1-10"]
    end
    
    subgraph Publisher1["Publisher: ins-product-aggregator"]
        IPA["ins-product-aggregator"]
        IPA_DB["PostgreSQL + Outbox"]
        IPA --> IPA_DB
    end
    
    subgraph EventBroker["Event Broker"]
        Kafka["Apache Kafka<br/><br/>Topics:<br/>• insurance-products<br/>• insurance-policies"]
    end
    
    subgraph Publisher2["Publisher: core-app"]
        CA["core-app"]
        CA_DB["PostgreSQL + Outbox"]
        CA --> CA_DB
    end
    
    subgraph Consumers["Consumers"]
        CA_Consumer["core-app<br/>(Consumer)"]
        ICS["ins-comp-settlement<br/>(Consumer)"]
    end
    
    %% Flows
    InsCompanies -.->|"Асинхронно<br/>периодически"| IPA
    
    IPA_DB -->|"Publish<br/>ProductUpdated"| Kafka
    CA_DB -->|"Publish<br/>PolicyCreated"| Kafka
    
    Kafka -->|"Subscribe<br/>products"| CA_Consumer
    Kafka -->|"Subscribe<br/>products & policies"| ICS
    
    %% Styling
    classDef publisherStyle fill:#438DD5,stroke:#2E6295,color:#fff,font-size:16px
    classDef dbStyle fill:#5C9EC6,stroke:#2E6295,color:#fff,font-size:14px
    classDef kafkaStyle fill:#FF6B35,stroke:#C54020,color:#fff,font-size:18px
    classDef consumerStyle fill:#7CB342,stroke:#558B2F,color:#fff,font-size:16px
    classDef extStyle fill:#999999,stroke:#6B6B6B,color:#fff,font-size:14px
    
    class IPA,CA publisherStyle
    class IPA_DB,CA_DB dbStyle
    class Kafka kafkaStyle
    class CA_Consumer,ICS consumerStyle
    class InsCompanies extStyle
