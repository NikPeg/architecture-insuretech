graph TB
    subgraph Legend["📋 Легенда"]
        L1["🟢 Active - обрабатывает трафик"]
        L2["🟡 Standby - готов к переключению"]
        L3["🔴 Failed - отказ компонента"]
        L4["✅ Health Check успешен"]
        L5["❌ Health Check неуспешен"]
    end

    subgraph NormalOperation["✅ Нормальная работа - Active-Active"]
        User1["👤 Пользователь<br/>Москва"]
        User2["👤 Пользователь<br/>СПб"]
        User3["👤 Пользователь<br/>Екатеринбург"]

        GSLB_N["🌍 GSLB<br/>━━━━━━━━━━━━━━<br/>Status: Active<br/>Health: ✅ Both DCs"]

        DC1_N["🟢 ЦОД-1 Москва<br/>━━━━━━━━━━━━━━<br/>Status: Active<br/>Load: 50%<br/>Health: ✅"]
        DC2_N["🟢 ЦОД-2 СПб<br/>━━━━━━━━━━━━━━<br/>Status: Active<br/>Load: 50%<br/>Health: ✅"]

        User1 -->|"Geographic routing<br/>Low latency"| GSLB_N
        User2 -->|"Geographic routing<br/>Low latency"| GSLB_N
        User3 -->|"Geographic routing<br/>Low latency"| GSLB_N

        GSLB_N -->|"50% traffic<br/>Nearest DC"| DC1_N
        GSLB_N -->|"50% traffic<br/>Nearest DC"| DC2_N
    end

    subgraph Scenario1["⚠️ Сценарий 1: Отказ ЦОД-1"]
        User1_S1["👤 Пользователь<br/>Москва"]
        User2_S1["👤 Пользователь<br/>СПб"]
        User3_S1["👤 Пользователь<br/>Екатеринбург"]

        GSLB_S1["🌍 GSLB<br/>━━━━━━━━━━━━━━<br/>Status: Failover mode<br/>Health: ❌ DC1, ✅ DC2"]

        DC1_S1["🔴 ЦОД-1 Москва<br/>━━━━━━━━━━━━━━<br/>Status: Failed<br/>Health: ❌<br/>RTO: 10-30 sec"]
        DC2_S1["🟢 ЦОД-2 СПб<br/>━━━━━━━━━━━━━━<br/>Status: Active<br/>Load: 100%<br/>Health: ✅<br/>Auto-scale: ON"]

        User1_S1 -->|"Failover<br/>DNS update"| GSLB_S1
        User2_S1 -->|"Direct routing"| GSLB_S1
        User3_S1 -->|"Failover<br/>DNS update"| GSLB_S1

        GSLB_S1 -->|"0% traffic"| DC1_S1
        GSLB_S1 -->|"100% traffic<br/>All requests"| DC2_S1

        DC2_S1 -.->|"Auto-scale<br/>pods & nodes"| AutoScale["⚡ Cluster Autoscaler<br/>+ HPA<br/>━━━━━━━━━━━━━━<br/>Scale up to<br/>handle 100% load"]
    end

    subgraph DBFailover["🗄️ Database Failover Scenario"]
        subgraph DBNormal["Normal State"]
            DB1_M_N["🟢 PG Master DC1<br/>━━━━━━━━━━━━━━<br/>Read/Write<br/>Health: ✅"]
            DB2_M_N["🟢 PG Master DC2<br/>━━━━━━━━━━━━━━<br/>Read/Write<br/>Health: ✅"]
            DB1_R_N["🟢 PG Replica DC1<br/>━━━━━━━━━━━━━━<br/>Read only"]
            DB2_R_N["🟢 PG Replica DC2<br/>━━━━━━━━━━━━━━<br/>Read only"]

            DB1_M_N <-->|"Sync replication<br/>Patroni"| DB2_M_N
            DB1_M_N -->|Async| DB1_R_N
            DB2_M_N -->|Async| DB2_R_N
        end

        subgraph DBFail["Master DC1 Failed"]
            DB1_M_F["🔴 PG Master DC1<br/>━━━━━━━━━━━━━━<br/>Status: Failed<br/>Health: ❌"]
            DB2_M_F["🟢 PG Master DC2<br/>━━━━━━━━━━━━━━<br/>Read/Write<br/>Primary role"]
            DB1_R_F["🟡 PG Replica DC1<br/>━━━━━━━━━━━━━━<br/>Promoted to Master<br/>RTO: 1-2 min"]
            DB2_R_F["🟢 PG Replica DC2<br/>━━━━━━━━━━━━━━<br/>Read only"]

            Patroni["🔧 Patroni<br/>━━━━━━━━━━━━━━<br/>Auto-failover<br/>Leader election"]

            DB1_M_F -.->|"Detect failure<br/>10 seconds"| Patroni
            Patroni -->|"Promote replica"| DB1_R_F
            DB1_R_F <-->|"New sync pair"| DB2_M_F
            DB2_M_F -->|Async| DB2_R_F
        end
    end

    subgraph HealthChecks["🏥 Health Check Architecture"]
        HC1["Level 1: GSLB<br/>━━━━━━━━━━━━━━<br/>HTTP/HTTPS check<br/>Interval: 10s<br/>Timeout: 5s<br/>Failures: 3"]
        HC2["Level 2: ALB<br/>━━━━━━━━━━━━━━<br/>TCP check<br/>Interval: 5s<br/>Timeout: 3s<br/>Failures: 2"]
        HC3["Level 3: Ingress<br/>━━━━━━━━━━━━━━<br/>HTTP check<br/>Interval: 3s<br/>Timeout: 2s<br/>Failures: 2"]
        HC4["Level 4: Pod<br/>━━━━━━━━━━━━━━<br/>Liveness: 10s<br/>Readiness: 5s<br/>Startup: 30s"]
        HC5["Level 5: Database<br/>━━━━━━━━━━━━━━<br/>Patroni API<br/>Interval: 10s<br/>Auto-failover: ON"]

        HC1 -->|Check endpoint| HC2
        HC2 -->|Check endpoint| HC3
        HC3 -->|Check endpoint| HC4
        HC4 -.->|DB connection| HC5
    end

    subgraph RecoveryPlan["🔄 Recovery Time Objectives"]
        RTO1["Pod failure<br/>━━━━━━━━━━━━━━<br/>Detection: 10s<br/>Recovery: 30-60s<br/>Total RTO: 1-2 min"]
        RTO2["Node failure<br/>━━━━━━━━━━━━━━<br/>Detection: 30s<br/>Recovery: 2-3 min<br/>Total RTO: 3-4 min"]
        RTO3["DB Master failure<br/>━━━━━━━━━━━━━━<br/>Detection: 10s<br/>Failover: 1-2 min<br/>Total RTO: 2-3 min"]
        RTO4["Full DC failure<br/>━━━━━━━━━━━━━━<br/>Detection: 10s<br/>DNS switch: 10-30s<br/>Scale up: 5-15 min<br/>Total RTO: 15-20 min"]
        RTO5["Disaster<br/>Both DCs failed<br/>━━━━━━━━━━━━━━<br/>Detection: 1 min<br/>Restore from backup: 30 min<br/>Deploy apps: 10 min<br/>Testing: 5 min<br/>Total RTO: 45 min"]

        RTO1 -->|Escalate if fails| RTO2
        RTO2 -->|Escalate if fails| RTO4
        RTO3 -.->|Independent| RTO4
        RTO4 -->|Worst case| RTO5
    end

    subgraph DataProtection["💾 Data Protection - RPO Strategy"]
        Strategy1["Sync Replication<br/>━━━━━━━━━━━━━━<br/>Between DC masters<br/>RPO: 0 sec<br/>For critical writes"]
        Strategy2["Incremental Backup<br/>━━━━━━━━━━━━━━<br/>Every 15 minutes<br/>RPO: 15 min<br/>pgBackRest to S3"]
        Strategy3["Full Backup<br/>━━━━━━━━━━━━━━<br/>Daily at 02:00<br/>Retention: 90 days<br/>Compressed & encrypted"]
        Strategy4["Cross-region replication<br/>━━━━━━━━━━━━━━<br/>S3 to S3<br/>Async replication<br/>For disaster recovery"]

        Strategy1 -->|"Primary protection"| Strategy2
        Strategy2 -->|"Based on"| Strategy3
        Strategy3 -->|"Replicated"| Strategy4
    end

    %% Styling
    classDef activeStyle fill:#4caf50,stroke:#ffffff,stroke-width:3px,color:#ffffff
    classDef failedStyle fill:#f44336,stroke:#ffffff,stroke-width:3px,color:#ffffff
    classDef standbyStyle fill:#ff9800,stroke:#ffffff,stroke-width:3px,color:#ffffff
    classDef healthStyle fill:#2196f3,stroke:#ffffff,stroke-width:2px,color:#ffffff
    classDef recoveryStyle fill:#9c27b0,stroke:#ffffff,stroke-width:2px,color:#ffffff

    class DC1_N,DC2_N,DC2_S1,DB1_M_N,DB2_M_N,DB1_R_N,DB2_R_N,DB2_M_F,DB2_R_F activeStyle
    class DC1_S1,DB1_M_F failedStyle
    class DB1_R_F standbyStyle
    class HC1,HC2,HC3,HC4,HC5 healthStyle
    class RTO1,RTO2,RTO3,RTO4,RTO5 recoveryStyle
